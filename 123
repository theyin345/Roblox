-- 2. 核心打谱逻辑（长条尾巴物理追踪法）
--========================================

local function releaseAllKeys()
    for arrowIdx, isPressed in pairs(State.ActiveKeys) do
        if isPressed then
            VirtualInputManager:SendKeyEvent(false, Config.KeyBinds[arrowIdx], false, game)
            State.ActiveKeys[arrowIdx] = false
        end
    end
end

local function getActiveKeySync()
    local mainGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
    local matchFrame = mainGui and mainGui:FindFirstChild("MatchFrame")
    if not (matchFrame and matchFrame.Visible) then return nil end
    
    local playerSide = "KeySync1"
    local file = LocalPlayer:FindFirstChild("File")
    if file and file:FindFirstChild("CurrentPlayer") then
        if file.CurrentPlayer.Value and file.CurrentPlayer.Value.Name == "Player2" then
            playerSide = "KeySync2"
        end
    end
    
    return matchFrame:FindFirstChild(playerSide)
end

local function processHit(arrowIdx, note, folder)
    if State.ActiveKeys[arrowIdx] then return end 
    State.ActiveKeys[arrowIdx] = true
    
    task.spawn(function()
        local key = Config.KeyBinds[arrowIdx]
        
        -- 1. 模拟按下按键
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        
        -- 2. 去 Notes 文件夹里寻找对应的 Hold 尾巴
        local notesFolder = folder:FindFirstChild("Notes")
        local activeHold = nil
        
        if notesFolder then
            -- 优先精准匹配：根据你的描述，如果是音符 ID 关联，直接找 "Hold_对应名字"
            activeHold = notesFolder:FindFirstChild("Hold_" .. tostring(note.Name))
            
            -- 如果名字没对上，执行后备方案：找当前轨道里任意一个名字带 "Hold" 的物体
            if not activeHold then
                for _, child in ipairs(notesFolder:GetChildren()) do
                    if string.find(child.Name, "Hold") then
                        activeHold = child
                        break
                    end
                end
            end
        end
        
        -- 3. 判断并执行长按逻辑
        if activeHold then
            -- 核心修复：彻底放弃时间计算，只要这个 Hold 尾巴还在游戏里没消失，就死死按住！
            while activeHold and activeHold.Parent and activeHold.Visible do
                RunService.Heartbeat:Wait()
                
                -- 双重保险：如果长条快被吃完了，高度变得极小（小于5像素），说明该松手了
                if activeHold.AbsoluteSize.Y < 5 then
                    break
                end
            end
        else
            -- 普通短音符：极短延迟后立刻松开
            task.wait(0.03)
        end

        -- 4. 长条彻底结束或短音符结束，松开按键
        VirtualInputManager:SendKeyEvent(false, key, false, game)
        State.ActiveKeys[arrowIdx] = false
    end)
end

-- 扫描主循环
local function engageAutoPlayer()
    if State.MainLoop then State.MainLoop:Disconnect() end
    
    State.MainLoop = RunService.Heartbeat:Connect(function()
        if not State.Enabled then return end
        
        local KeySync = getActiveKeySync()
        if not KeySync then return end
        
        for i = 1, 4 do
            -- 注意这里用的是正确的字符串拼接符号 `..`，不再会报错
            local folder = KeySync:FindFirstChild("Arrow" .. i)
            local receptor = folder and folder:FindFirstChild("Arrow")
            local notes = folder and folder:FindFirstChild("Notes")
            
            if receptor and notes then
                local targetY = receptor.AbsolutePosition.Y
                
                for _, note in ipairs(notes:GetChildren()) do
                    if State.ProcessedNotes[note] or not note:IsA("GuiObject") or not note.Visible or note.Name == "Arrow" or string.find(note.Name, "Hold") then 
                        continue 
                    end
                    
                    local diff = note.AbsolutePosition.Y - targetY
                    
                    if math.abs(diff) <= Config.HitPixels then
                        State.ProcessedNotes[note] = true 
                        
                        -- 把音符和它所在的 folder 传进去，以便直接查找尾巴
                        processHit(i, note, folder)
                        
                        note.AncestryChanged:Once(function() 
                            State.ProcessedNotes[note] = nil 
                        end)
                        
                        break 
                    end
                end
            end
        end
    end)
end

