local AutoPlayer = false
local Player = 0
local plr = game.Players.LocalPlayer
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")
local main = plr.PlayerGui:WaitForChild("Main") -- Ensure Main exists
local accuracy = 50 

spawn(function()
    while task.wait() do
        if AutoPlayer then
            if plr.File and plr.File:FindFirstChild("CurrentPlayer") and plr.File.CurrentPlayer.Value then
                if plr.File.CurrentPlayer.Value.Name == "Player1" then
                    Player = 1
                elseif plr.File.CurrentPlayer.Value.Name == "Player2" then
                    Player = 2
                else
                    Player = 0
                end
            else
                Player = 0
            end
        end
    end
end)

local Tab2AutoPlayToggle = Tab2:CreateToggle({
    Name = "自动点击",
    CurrentValue = AutoPlayer,
    Flag = "自动点击",
    Callback = function(Value)
        AutoPlayer = Value
    end
})

Tab2:CreateSlider({
    Name = "准确度(acc)",
    Range = {0, 100},
    Increment = 1,
    Suffix = "%",
    CurrentValue = 50,
    Flag = "准确度",
    Callback = function(Value)
        accuracy = Value
    end
})

local function lol(num, keke)
    local tyingarrow = {}
    while true do
        task.wait()
        if AutoPlayer and Player > 0 then
            local keySync = main.MatchFrame:FindFirstChild("KeySync" .. Player)
            if keySync and keySync:FindFirstChild("Arrow" .. num) then
                for i, v in pairs(keySync["Arrow" .. num].Notes:GetChildren()) do
                    if v:IsA("ImageLabel") then
                        -- Convert accuracy (0-100%) to speed (1 to 0.01)
                        local speed = 1 - (accuracy / 100) * 0.99 -- 0% = 1, 100% = 0.01
                        if v.Position.Y.Scale <= speed and not table.find(tyingarrow, v) then
                            table.insert(tyingarrow, v)
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[keke], 0, nil)
                            spawn(function()
                                local hold = keySync["Arrow" .. num].Hold.Hitbox:WaitForChild(v.Name, 0.1)
                                if hold and hold.Size.Y.Scale > 0 then
                                    repeat task.wait() until hold.Position.Y.Scale + hold.Size.Y.Scale <= speed or not hold
                                end
                                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[keke], 0, nil)
                                table.remove(tyingarrow, i)
                            end)
                        end
                    end
                end
            end
        end
    end
end

spawn(function() lol(1, "A") end)
spawn(function() lol(2, "S") end)
spawn(function() lol(3, "W") end)
spawn(function() lol(4, "D") end)

