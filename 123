-- 6. 优化环境 (清理多余跳字弹窗/减少卡顿)
local optimizing = false
local optimizeThread

local function clearUIElements()
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in ipairs(playerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    for _, desc in ipairs(gui:GetDescendants()) do
                        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Text then
                            local txt = desc.Text
                            if txt:find("%+%d+") or txt:find("Coins") or txt:find("金币") then
                                local parentGui = desc:FindFirstAncestorWhichIsA("ScreenGui")
                                if parentGui then
                                    parentGui:Destroy()
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

MainTab:CreateToggle({
    Name = "自动优化环境 (自动清理干扰UI)",
    CurrentValue = false,
    Flag = "OptimizeToggle",
    Callback = function(state)
        optimizing = state
        if optimizing then
            if optimizeThread then task.cancel(optimizeThread) end
            optimizeThread = task.spawn(function()
                while optimizing do
                    pcall(clearUIElements)
                    task.wait(0.5)
                end
            end)
            Rayfield:Notify({ Title = "提示", Content = "环境优化已开启", Duration = 2 })
        else
            if optimizeThread then task.cancel(optimizeThread) end
            Rayfield:Notify({ Title = "提示", Content = "环境优化已关闭", Duration = 2 })
        end
    end,
})

MainTab:CreateButton({
    Name = "立即清理一次垃圾画面",
    Callback = function()
        clearUIElements()
        Rayfield:Notify({ Title = "成功", Content = "已清理完毕", Duration = 2 })
    end,
})
